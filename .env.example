# ==============================================================================
# Il Mio Garage Backend - Configurazione Ambiente (.env.example)
# Copia questo file in .env o imposta queste variabili nel tuo ambiente di esecuzione
# ==============================================================================

# Database PostgreSQL (es. Neon o PostgreSQL locale)
# Per Neon ricordarsi di includere ?sslmode=require
DB_URL=jdbc:postgresql://ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=your_neon_password_here

# JWT Secret (chiave HMAC SHA-256 codificata in Base64 o stringa di almeno 256 bit / 32 caratteri)
# NON committare segreti reali nel repository!
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=2592000

# CORS Allowed Origins (separati da virgola, es. Expo dev server e web)
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,exp://192.168.1.100:8081

# Server port (default: 8080)
PORT=8080
